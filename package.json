{
  "name": "core-jxa",
  "version": "1.0.0",
  "description": "Run core-js under macOS JavaScript for Automation",
  "private": true,
  "scripts": {
    "build": "esbuild src/core-js-jxa.js --bundle --platform=browser --format=iife --target=safari13 --outfile=dist/core-js-jxa.js",
    "build:polyfills": "esbuild src/polyfills-jxa.js --bundle --platform=browser --format=iife --target=esnext --outfile=dist/polyfills-jxa.js",
    "start": "npm run build && osascript -l JavaScript dist/core-js-jxa.js",
    "start:polyfills": "npm run build:polyfills && osascript -l JavaScript dist/polyfills-jxa.js",
    "test": "node scripts/build-tests.js && node scripts/run-tests.js"
  },
  "keywords": [
    "core-js",
    "jxa"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@web-std/blob": "^3.0.5",
    "@zxing/text-encoding": "^0.9.0",
    "core-js": "^3.50.0",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "core-js-pure": "^3.50.0",
    "esbuild": "^0.28.2",
    "qunit": "^2.26.0"
  }
}
